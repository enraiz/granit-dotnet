<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Templating.Workflow</PackageId>
    <Description>Optional bridge between Granit.Templating and Granit.Workflow. Replaces the default NullTemplateTransitionHook with a Workflow-aware implementation providing FSM validation, approval routing, unified HDS audit trail (WorkflowTransitionRecord) and domain events.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Templating.Workflow.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Templating\Granit.Templating.csproj" />
    <ProjectReference Include="..\Granit.Workflow\Granit.Workflow.csproj" />
    <ProjectReference Include="..\Granit.Workflow.EntityFrameworkCore\Granit.Workflow.EntityFrameworkCore.csproj" />
  </ItemGroup>

</Project>
