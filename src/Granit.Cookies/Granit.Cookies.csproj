<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Cookies</PackageId>
    <Description>Gestion centralisee des cookies HTTP avec Strict Registry Pattern.
    Consentement RGPD by design, fail-fast sur cookies non enregistres.
    Conforme GDPR/ISO 27001.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Cookies.Tests" />
    <InternalsVisibleTo Include="Granit.Cookies.Klaro" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Timing\Granit.Timing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\**\*.json" />
  </ItemGroup>

</Project>
