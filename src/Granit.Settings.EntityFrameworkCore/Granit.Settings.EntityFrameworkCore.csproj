<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Settings.EntityFrameworkCore</PackageId>
    <Description>Persistance EF Core pour Granit.Settings. L'application cliente implémente ISettingsDbContext sur son DbContext existant et appelle modelBuilder.ConfigureSettingsModule() — aucun DbContext dédié, zéro connexion supplémentaire. Audit HDS automatique via AuditedEntityInterceptor.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Settings.EntityFrameworkCore.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Persistence\Granit.Persistence.csproj" />
    <ProjectReference Include="..\Granit.Settings\Granit.Settings.csproj" />
  </ItemGroup>

</Project>
