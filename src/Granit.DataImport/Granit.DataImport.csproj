<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.DataImport</PackageId>
    <Description>Socle d'import de données pour Granit. Pipeline streaming Extract → Map → Validate → Execute avec Fluent API (ImportDefinition), smart mapping 4-tier (Saved → Exact → Fuzzy → Semantic IA optionnelle RGPD-safe), résolution INSERT/UPDATE (roundtrip), rapport partiel, et fichier de correction.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.DataImport.Tests" />
    <InternalsVisibleTo Include="Granit.DataImport.Csv" />
    <InternalsVisibleTo Include="Granit.DataImport.Excel" />
    <InternalsVisibleTo Include="Granit.DataImport.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Granit.DataImport.Endpoints" />
    <!-- Required by NSubstitute (Castle.DynamicProxy) to mock internal types in tests -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Core\Granit.Core.csproj" />
    <ProjectReference Include="..\Granit.Timing\Granit.Timing.csproj" />
    <ProjectReference Include="..\Granit.Validation\Granit.Validation.csproj" />
    <!-- Optional at runtime: ICurrentTenant resolved via GetService — no GranitMultiTenancyModule required -->
  </ItemGroup>

</Project>
