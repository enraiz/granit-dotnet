<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Analyzers</PackageId>
    <!-- Analyzers must target netstandard2.0 to be compatible with all SDK versions -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>Roslyn analyzers enforcing the Granit Expand &amp; Contract zero-downtime migration pattern.</Description>
    <IsPackable>true</IsPackable>
    <!-- Analyzer packages: DLL goes in analyzers/, not in lib/ -->
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Enable extended analyzer correctness rules (RS1xxx) -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- NU5128: expected for analyzer packages — output goes to analyzers/, not lib/ -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pack the analyzer DLL into the correct NuGet path -->
    <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
