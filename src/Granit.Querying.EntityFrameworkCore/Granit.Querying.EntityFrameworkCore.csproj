  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Querying\Granit.Querying.csproj" />
    <ProjectReference Include="..\Granit.Persistence\Granit.Persistence.csproj" />
  </ItemGroup>

</Project>
