<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>DigitalDynamics.Foundation.ApiVersioning</PackageId>
    <Description>URL-based API versioning for Digital Dynamics Foundation applications. Registers Asp.Versioning with URL + query string readers and sensible defaults.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DigitalDynamics.Foundation.ApiVersioning.Tests" />
    <InternalsVisibleTo Include="DigitalDynamics.Foundation.ApiDocumentation" />
    <InternalsVisibleTo Include="DigitalDynamics.Foundation.ApiDocumentation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DigitalDynamics.Foundation.Core\DigitalDynamics.Foundation.Core.csproj" />
  </ItemGroup>
</Project>
