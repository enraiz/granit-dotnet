<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>DigitalDynamics.Foundation.Caching.StackExchangeRedis</PackageId>
    <Description>Fournisseur Redis pour DigitalDynamics.Foundation.Caching.
    Remplace IDistributedCache (MemoryDistributedCache) par RedisCache (StackExchange.Redis).
    Active le chiffrement AES-256 automatiquement si CachingOptions.EncryptValues = true.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DigitalDynamics.Foundation.Caching.StackExchangeRedis.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DigitalDynamics.Foundation.Caching\DigitalDynamics.Foundation.Caching.csproj" />
  </ItemGroup>

</Project>
