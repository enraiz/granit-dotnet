<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Persistence.Migrations</PackageId>
    <Description>Framework Zero-Downtime Migrations Expand &amp; Contract pour EF Core. Suivi de progression, isolation multi-tenant agnostique et orchestration des batches via Wolverine.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Persistence.Migrations.Tests" />
    <!-- Required by NSubstitute (Castle.DynamicProxy) to mock internal interfaces in tests -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="WolverineFx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Core\Granit.Core.csproj" />
    <ProjectReference Include="..\Granit.Persistence\Granit.Persistence.csproj" />
    <ProjectReference Include="..\Granit.Timing\Granit.Timing.csproj" />
    <ProjectReference Include="..\Granit.Wolverine\Granit.Wolverine.csproj" />
  </ItemGroup>

</Project>
