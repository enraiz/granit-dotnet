<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Localization</PackageId>
    <Description>Localisation JSON modulaire inspirée ABP. IStringLocalizer avec ressources embarquées, héritage inter-modules et culture fallback.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Localization.Tests" />
    <!-- Required by EF Core module to access CachedLocalizationOverrideStore.RawStoreKey -->
    <InternalsVisibleTo Include="Granit.Localization.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Granit.Localization.EntityFrameworkCore.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="SmartFormat" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Core\Granit.Core.csproj" />
    <!-- Optional at runtime: ICurrentTenant resolved via GetService for cache key scoping -->
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\**\*.json" />
  </ItemGroup>

</Project>
