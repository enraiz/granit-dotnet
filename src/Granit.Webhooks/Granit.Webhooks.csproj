<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Webhooks</PackageId>
    <Description>Outbound webhook delivery engine for Granit. Async dispatch via Wolverine outbox, HMAC-SHA256 anti-replay signatures, durable exponential backoff, payload-type agnostic (thin ISO 27001 or fat standard).</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Webhooks.Tests" />
    <InternalsVisibleTo Include="Granit.Webhooks.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Granit.Webhooks.EntityFrameworkCore.Tests" />
    <!-- Required by NSubstitute (Castle.DynamicProxy) to mock internal interfaces in tests -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Core\Granit.Core.csproj" />
    <ProjectReference Include="..\Granit.Guids\Granit.Guids.csproj" />
    <ProjectReference Include="..\Granit.Timing\Granit.Timing.csproj" />
    <ProjectReference Include="..\Granit.Wolverine\Granit.Wolverine.csproj" />
  </ItemGroup>

</Project>
