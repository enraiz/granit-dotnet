<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>DigitalDynamics.Foundation.ApiDocumentation</PackageId>
    <Description>OpenAPI documentation and Scalar UI for Digital Dynamics Foundation applications. Generates one OpenAPI document per declared API version, with JWT Bearer security scheme and [InternalApi] endpoint filtering.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DigitalDynamics.Foundation.ApiDocumentation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DigitalDynamics.Foundation.ApiVersioning\DigitalDynamics.Foundation.ApiVersioning.csproj" />
    <ProjectReference Include="..\DigitalDynamics.Foundation.Security\DigitalDynamics.Foundation.Security.csproj" />
  </ItemGroup>
</Project>
