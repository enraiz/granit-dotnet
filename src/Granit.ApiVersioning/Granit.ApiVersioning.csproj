<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Granit.ApiVersioning</PackageId>
    <Description>URL-based API versioning for Digital Dynamics Granit applications. Registers Asp.Versioning with URL + query string readers and sensible defaults.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.ApiVersioning.Tests" />
    <InternalsVisibleTo Include="Granit.ApiDocumentation" />
    <InternalsVisibleTo Include="Granit.ApiDocumentation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Core\Granit.Core.csproj" />
  </ItemGroup>
</Project>
