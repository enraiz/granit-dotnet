    <ProjectReference Include="..\..\Granit.Templating.EntityFrameworkCore\Granit.Templating.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\Granit.DocumentGeneration\Granit.DocumentGeneration.csproj" />
    <ProjectReference Include="..\..\Granit.DocumentGeneration.Pdf\Granit.DocumentGeneration.Pdf.csproj" />
    <ProjectReference Include="..\..\Granit.DocumentGeneration.Excel\Granit.DocumentGeneration.Excel.csproj" />
  </ItemGroup>

</Project>
