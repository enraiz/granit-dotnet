<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Validation</PackageId>
    <Description>Module de validation FluentValidation pour Granit. Fournit GranitValidator&lt;T&gt; (CascadeMode.Continue), GranitErrorCodeLanguageManager (codes d'erreur standardisés Granit:Validation:*) et des extensions de validation pour les identifiants réglementés (NISS belge, RPPS, ADELI, FINESS français, IBAN, E.164).</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Validation.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.ExceptionHandling\Granit.ExceptionHandling.csproj" />
    <ProjectReference Include="..\Granit.Localization\Granit.Localization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\**\*.json" />
  </ItemGroup>

</Project>
