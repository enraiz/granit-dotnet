<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Cookies.Klaro</PackageId>
    <Description>Klaro CMP integration for Granit.Cookies: reads the Klaro consent cookie,
    maps Klaro services to RGPD categories, and implements IConsentResolver.
    RGPD/HDS compliant.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Cookies.Klaro.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Cookies\Granit.Cookies.csproj" />
  </ItemGroup>

</Project>
