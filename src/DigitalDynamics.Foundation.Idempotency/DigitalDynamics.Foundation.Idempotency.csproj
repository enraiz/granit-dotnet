<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>DigitalDynamics.Foundation.Idempotency</PackageId>
    <Description>Middleware d'idempotence HTTP pour les API publiques (style Stripe).
    Stockage atomique via Redis SET NX PX. Machine à états Absent → InProgress → Completed.
    Chiffrement AES-256 opt-in via ICacheValueEncryptor. Conforme HDS/RGPD.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DigitalDynamics.Foundation.Idempotency.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DigitalDynamics.Foundation.Core\DigitalDynamics.Foundation.Core.csproj" />
    <ProjectReference Include="..\DigitalDynamics.Foundation.Caching\DigitalDynamics.Foundation.Caching.csproj" />
    <ProjectReference Include="..\DigitalDynamics.Foundation.Security\DigitalDynamics.Foundation.Security.csproj" />
    <ProjectReference Include="..\DigitalDynamics.Foundation.MultiTenancy\DigitalDynamics.Foundation.MultiTenancy.csproj" />
  </ItemGroup>

</Project>
