<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Features</PackageId>
    <Description>Module de Feature Management SaaS pour Granit. Résolution multi-niveaux (Default → Plan → Tenant), cache hybride IHybridCache, [RequiresFeature] ASP.NET Core et Wolverine, IFeatureLimitGuard pour les limites numériques.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Features.Tests" />
    <InternalsVisibleTo Include="Granit.Features.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Granit.Features.EntityFrameworkCore.Tests" />
    <!-- Required by NSubstitute (Castle.DynamicProxy) to mock internal interfaces in tests -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Core\Granit.Core.csproj" />
    <ProjectReference Include="..\Granit.Caching.Hybrid\Granit.Caching.Hybrid.csproj" />
    <ProjectReference Include="..\Granit.Localization\Granit.Localization.csproj" />
    <!-- Optional at runtime: ICurrentTenant resolved via GetService — no GranitMultiTenancyModule required -->
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\**\*.json" />
  </ItemGroup>

</Project>
