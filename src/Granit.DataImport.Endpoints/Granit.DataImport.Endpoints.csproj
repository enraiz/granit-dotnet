<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.DataImport.Endpoints</PackageId>
    <Description>Minimal API endpoints for the Granit data import pipeline. Exposes upload, preview, mapping, execution (async + dry-run), status, report, and correction file endpoints. Protected by the DataImport.Admin permission policy.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.DataImport.Endpoints.Tests" />
    <!-- Required by NSubstitute (Castle.DynamicProxy) to mock internal interfaces in tests -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Authorization\Granit.Authorization.csproj" />
    <ProjectReference Include="..\Granit.DataImport\Granit.DataImport.csproj" />
  </ItemGroup>

</Project>
