<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Validation.NorthAmerica</PackageId>
    <Description>North American identifier and address validators for Granit (United States, Canada). SSN, EIN, ZIP, NANP phone, state codes, SIN, postal codes, business numbers and more.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Validation.NorthAmerica.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Localization\Granit.Localization.csproj" />
    <ProjectReference Include="..\Granit.Validation\Granit.Validation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\**\*.json" />
  </ItemGroup>

</Project>
