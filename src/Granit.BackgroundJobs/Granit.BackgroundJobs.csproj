<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.BackgroundJobs</PackageId>
    <Description>Module de background jobs durable et pilotable pour Granit. Déclaration via [RecurringJob], scheduling Wolverine atomique via Outbox, store EF Core agnostique (SQL Server / PostgreSQL), IBackgroundJobReader/IBackgroundJobWriter pour l'administration (CQRS).</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.BackgroundJobs.Tests" />
    <InternalsVisibleTo Include="Granit.BackgroundJobs.Tests.Integration" />
    <InternalsVisibleTo Include="Granit.BackgroundJobs.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Granit.BackgroundJobs.EntityFrameworkCore.Tests" />
    <!-- Required by NSubstitute (Castle.DynamicProxy) to mock internal interfaces in tests -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cronos" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Core\Granit.Core.csproj" />
    <ProjectReference Include="..\Granit.Guids\Granit.Guids.csproj" />
    <ProjectReference Include="..\Granit.Timing\Granit.Timing.csproj" />
    <ProjectReference Include="..\Granit.Wolverine\Granit.Wolverine.csproj" />
  </ItemGroup>

</Project>
