    <Description>Wolverine integration for Granit.Webhooks: durable outbox-backed webhook dispatch via IMessageBus, local queues with exponential backoff retry.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Webhooks.Wolverine.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WolverineFx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Webhooks\Granit.Webhooks.csproj" />
    <ProjectReference Include="..\Granit.Wolverine\Granit.Wolverine.csproj" />
  </ItemGroup>

</Project>
