<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Localization.DatabaseSource</PackageId>
    <Description>Cache decorator for ILocalizationOverrideStore. Wraps any ILocalizationOverrideStore implementation (e.g. EF Core) with IMemoryCache for sync-safe access from IStringLocalizer. Optional multi-tenant support via ICurrentTenant.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Localization.DatabaseSource.Tests" />
    <InternalsVisibleTo Include="Granit.Localization.DatabaseSource.EntityFrameworkCore" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Core\Granit.Core.csproj" />
    <ProjectReference Include="..\Granit.Localization\Granit.Localization.csproj" />
    <!-- Optional at runtime: ICurrentTenant resolved via GetService — no GranitMultiTenancyModule required -->
    <ProjectReference Include="..\Granit.MultiTenancy\Granit.MultiTenancy.csproj" />
  </ItemGroup>

</Project>
