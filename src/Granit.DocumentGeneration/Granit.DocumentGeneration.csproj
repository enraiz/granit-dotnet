<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.DocumentGeneration</PackageId>
    <Description>Couche de génération de documents (PDF, Excel) au-dessus de Granit.Templating. Fournit IDocumentGenerator, IDocumentRenderer et DocumentTemplateType. Les renderers concrets (PuppeteerSharp, ClosedXML) vivent dans des packages séparés.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.DocumentGeneration.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Templating\Granit.Templating.csproj" />
  </ItemGroup>

</Project>
