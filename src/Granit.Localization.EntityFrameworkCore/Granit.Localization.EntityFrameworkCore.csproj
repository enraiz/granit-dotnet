<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Localization.EntityFrameworkCore</PackageId>
    <Description>EF Core implementation of ILocalizationOverrideStore for Granit.Localization. Persists translation overrides in PostgreSQL (table granit_localization_overrides) with HDS audit trail and multi-tenant isolation.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Localization.EntityFrameworkCore.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Core\Granit.Core.csproj" />
    <ProjectReference Include="..\Granit.Persistence\Granit.Persistence.csproj" />
    <ProjectReference Include="..\Granit.Localization\Granit.Localization.csproj" />
  </ItemGroup>

</Project>
