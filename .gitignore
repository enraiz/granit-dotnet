# =============================================================================
# .gitignore - Granit
# =============================================================================

# --- .NET ---
bin/
obj/
out/
*.user
*.suo
*.DotSettings.user
nupkgs/
TestResults/

# --- Coverage (dotnet test + ReportGenerator) ---
**/coverage.opencover.xml
**/coverage.cobertura.xml
coverage-report/

# --- Environment ---
.env
.env.*
!.env.example

# --- IDE ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# --- AI tools (Claude Code) ---
# Commit settings.json and skills (shared with all contributors), ignore local overrides
.claude/settings.local.json

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Security (CRITICAL) ---
# NEVER commit these files
*.pem
*.key
*.cert
*.p12
*.pfx
credentials.json
secrets.json
token.json

# --- Logs ---
*.log
logs/

# --- Temporary ---
tmp/
temp/
*.tmp
