{
  "$schema": "http://json.schemastore.org/template",
  "author": "Digital Dynamics",
  "classifications": ["Web", "API", "Granit"],
  "identity": "Granit.Templates.Api",
  "name": "Granit Minimal API",
  "shortName": "granit-api",
  "description": "A minimal Granit API project with Bundle.Essentials and a sample endpoint.",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "GranitApi",
  "preferNameDirectory": true,
  "defaultName": "MyApi",
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "The target framework for the project.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net10.0",
          "description": "Target .NET 10"
        }
      ],
      "defaultValue": "net10.0",
      "replaces": "net10.0"
    },
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "description": "If specified, skips the automatic restore of the project on create.",
      "defaultValue": "false"
    }
  },
  "primaryOutputs": [
    {
      "path": "GranitApi.csproj"
    }
  ],
  "postActions": [
    {
      "condition": "(!skipRestore)",
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
