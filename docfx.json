{
  "metadata": [
    {
      "src": [
        {
          "files": ["src/**/*.csproj"],
          "exclude": [
            "**/obj/**",
            "**/bin/**",
            "**/Granit.Analyzers/**",
            "**/Granit.Analyzers.CodeFixes/**",
            "**/Granit.Localization.SourceGenerator/**",
            "**/Granit.Localization.Endpoints/**"
          ]
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/**.yml", "api/index.md"]
      },
      {
        "files": ["docs/**/*.md"],
        "exclude": ["**/obj/**", "**/bin/**"]
      }
    ],
    "resource": [
      {
        "files": ["docs/images/**"]
      }
    ],
    "dest": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appTitle": "Granit",
      "_appFooter": "Granit — Documentation",
      "_enableSearch": true,
      "_appLogoPath": "docs/images/granit-icon.svg"
    }
  }
}
